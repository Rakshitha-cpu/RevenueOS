# RevenueOS - Environment Configuration
# DO NOT place actual secrets in this file. This is a template for developers.

# 1. Gemini LLM API Key (Get this from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Razorpay Credentials (Get this from Razorpay Dashboard -> API Keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# 3. Webhook Secret (Used to securely verify Razorpay payloads)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
